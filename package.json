{
  "name": "dls-icons",
  "private": true,
  "version": "3.69.6",
  "description": "Icons for Baidu Light DLS.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "lint": "vp lint",
    "format": "vp fmt packages/site/src",
    "generate": "node build/generate.mjs",
    "sync": "node build/sync.mjs",
    "build": "pnpm generate --build-only && pnpm -r build",
    "version:bump": "bumpp package.json packages/*/package.json"
  },
  "keywords": [
    "svg",
    "icons",
    "baidu",
    "dls"
  ],
  "author": "Justineo <justice360@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@justineo/npmmirror-sync": "^0.1.0",
    "bumpp": "^7.2.0",
    "comment-mark": "^1.1.1",
    "less": "^4.1.3",
    "less-plugin-dls": "^11.6.5",
    "lodash": "^4.17.21",
    "pinyin-pro": "^3.16.2",
    "stringify-object": "^3.3.0",
    "svgo": "^2.8.3",
    "svgson": "^5.3.0",
    "vite-plus": "1.2.0"
  }
}
